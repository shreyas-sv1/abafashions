# Environment Variables for ABAfashions Server
# Copy this file to .env and fill in your real values

# ─── Database ──────────────────────────────────────────────────────────────────
# Get a free PostgreSQL URL from https://neon.tech or https://railway.app
DATABASE_URL="postgresql://postgres:password@localhost:5432/abafashions"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Change this to a long random string in production!
JWT_SECRET="abafashions_super_secret_change_this_in_production_2024"

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Get these from https://cloudinary.com (free account)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_URL="http://localhost:5173"
